# ==============================================================================
# Code0 Environment Variables (.env.example)
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=code_buddy
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/code_buddy
POOL_SIZE=10
MAX_OVERFLOW=20
POOL_RECYCLE=1800
SQL_ECHO=false

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_NAME=code:queue
REDIS_SUBMISSION_KEY_PREFIX=submission:
REDIS_REFRESH_TOKEN_PREFIX=refresh_token:
REDIS_REVOKED_TOKEN_PREFIX=revoked_token:
REDIS_RECONNECT_DELAY=5
REDIS_SOCKET_TIMEOUT=30
REDIS_CONNECT_TIMEOUT=10

# --- Application & Networking ---
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://code0.bbitclub.io,https://admin.bbit.io
API_BASE_URL=http://localhost:8000
SERVER_ACTIONS_ALLOWED_ORIGINS=localhost:3000,127.0.0.1:3000,localhost:3001,127.0.0.1:3001,code0.bbitclub.io,admin.bbit.io

# --- Code Execution Storage & DinD ---
CODE_BASE_DIR=/app/code
HOST_CODE_BASE_DIR=
DOCKER_HOST=tcp://dind:2375

# --- Execution Container Limits & Images ---
CONTAINER_MEMORY_LIMIT=256m
CONTAINER_CPU_LIMIT=1.0
CONTAINER_PIDS_LIMIT=50
DOCKER_IMAGE_PYTHON=python:3.12-alpine
DOCKER_IMAGE_CPP=gcc:12.5
DOCKER_IMAGE_C=gcc:12.5
DOCKER_IMAGE_JAVA=eclipse-temurin:22-jdk-alpine

# --- JWT Authentication ---
# Generate secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_strong_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cookie Authentication ---
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_PATH=/
COOKIE_DOMAIN=

# --- Email Notifications (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=codersclub@bbitclub.io
SSL_EMAIL=admin@bbitclub.io

# --- Logging ---
LOG_FILE_PATH=logs/audit.log
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
